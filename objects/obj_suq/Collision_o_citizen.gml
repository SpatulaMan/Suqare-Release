/// @description
if(room == r_lvl_41)
{
	switch(other.image_blend)
	{
		case c_fuchsia: pickup_item = 67; break;
		case c_blue: pickup_item = 68; break;
		case c_red: pickup_item = 69; break;
		case c_yellow: pickup_item = 70; break;
		case c_aqua: pickup_item = 71; break;
		case c_maroon: pickup_item = 72; break;
		case c_olive: pickup_item = 73; break;
		case c_orange: pickup_item = 74; break;
		case c_lime: pickup_item = 75; break;
		case c_purple: pickup_item = 76; break;
		case c_teal: pickup_item = 77; break;
	}
	pickup_timer = 90;
}